<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DevCore Launcher v1.0"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Universal Native Multi-Library Debugger"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select Libraries:"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🔄 SCAN"
            android:textSize="12sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewLibraries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A"
        android:divider="#333333"
        android:dividerHeight="1dp"
        android:padding="4dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnMoveUp"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="⬆️ MOVE UP"
            android:textSize="12sp"
            android:backgroundTint="#2D3748"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnMoveDown"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="⬇️ MOVE DOWN"
            android:textSize="12sp"
            android:backgroundTint="#2D3748"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/chkPassiveDependencies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Passive Dependencies (Cuma System.load target terakhir untuk cegah FMOD crash)"
        android:textColor="#A0AEC0"
        android:textSize="11sp"
        android:checked="true"
        android:buttonTint="#2563EB"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnExecute"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="🚀 EXECUTE LIBRARIES"
        android:textStyle="bold"
        android:textSize="15sp"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#1E1E1E">

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="#00FF66"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="Status: Ready" />
    </ScrollView>

</LinearLayout>
